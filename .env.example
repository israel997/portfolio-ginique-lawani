# Auto-injected by the Vercel Postgres/Neon integration once attached to the project.
POSTGRES_URL=

# Auto-injected by the Vercel Blob integration once attached to the project.
BLOB_READ_WRITE_TOKEN=

# Optional. Signs admin session cookies; when unset, a key is derived from
# POSTGRES_URL so the back-office works without any extra setup.
# The admin email and password hash live in api/_lib/auth.js.
SESSION_SECRET=
