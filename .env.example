# Auto-injected by the Vercel Postgres/Neon integration once attached to the project.
POSTGRES_URL=

# Auto-injected by the Vercel Blob integration once attached to the project.
BLOB_READ_WRITE_TOKEN=

# bcrypt hash of the admin back-office password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# Random 32+ byte secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
