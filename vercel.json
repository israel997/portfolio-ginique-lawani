{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|LinkedInBot|Twitterbot|TelegramBot|Slackbot|Discordbot|Googlebot|bingbot|Applebot|SkypeUriPreview|Pinterest|redditbot|Embedly|vkShare|Iframely|Mastodon|Signal|Viber|Snapchat).*"
        }
      ],
      "destination": "/api/og?path=/"
    },
    {
      "source": "/projets/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|LinkedInBot|Twitterbot|TelegramBot|Slackbot|Discordbot|Googlebot|bingbot|Applebot|SkypeUriPreview|Pinterest|redditbot|Embedly|vkShare|Iframely|Mastodon|Signal|Viber|Snapchat).*"
        }
      ],
      "destination": "/api/og?path=/projets/:id"
    },
    {
      "source": "/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|LinkedInBot|Twitterbot|TelegramBot|Slackbot|Discordbot|Googlebot|bingbot|Applebot|SkypeUriPreview|Pinterest|redditbot|Embedly|vkShare|Iframely|Mastodon|Signal|Viber|Snapchat).*"
        }
      ],
      "destination": "/api/og?path=/:slug"
    },
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/projets/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/:slug",
      "destination": "/app.html"
    }
  ]
}
